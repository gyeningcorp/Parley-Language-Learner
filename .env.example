# Server-side only. Never put these values in the browser or commit .env.
OPENAI_API_KEY=
PARLEY_MODEL=gpt-5.4
# Generate a random token, at least 24 characters. Used only by course administrators.
PARLEY_ADMIN_TOKEN=
PORT=3000
HOST=127.0.0.1
PARLEY_DATA_DIR=./data
# Required for writes behind an HTTPS reverse proxy, e.g. https://parley.example.com
PARLEY_PUBLIC_ORIGIN=
